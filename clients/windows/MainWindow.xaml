<Window
    x:Class="Resona.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Resona.Windows.Models"
    Title="Resona">
    <Grid Background="{ThemeResource ResonaSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{ThemeResource ResonaSurfaceContainerLowBrush}">
            <Grid Padding="14,36,14,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="12,0,0,32"
                    FontFamily="Georgia"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="Resona." />
                <ListView
                    x:Name="NavList"
                    Grid.Row="1"
                    SelectionChanged="OnNavSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="CornerRadius" Value="9" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Width="21" Height="21" Symbol="Library" />
                            <TextBlock Text="全部音乐" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Width="21" Height="21" Symbol="MusicInfo" />
                            <TextBlock Text="专辑" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Width="21" Height="21" Symbol="People" />
                            <TextBlock Text="艺术家" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Width="21" Height="21" Symbol="Favorite" />
                            <TextBlock Text="我喜欢的" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Width="21" Height="21" Symbol="Download" />
                            <TextBlock Text="已下载" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock
                        Opacity="0.7"
                        FontSize="12"
                        Text="已连接音乐服务器" />
                    <TextBlock
                        Opacity="0.7"
                        FontSize="12"
                        Text="0 首已下载 · 随时聆听" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Padding="28,16,16,8"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PageTitle"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="28"
                    FontWeight="Medium"
                    Text="全部音乐"
                    TextTrimming="CharacterEllipsis" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Width="255"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    PlaceholderText="搜索歌曲、专辑、艺术家"
                    TextChanged="OnSearchChanged" />
                <Button
                    x:Name="LoginButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="OnLoginClick"
                    ToolTipService.ToolTip="连接服务器">
                    <SymbolIcon Symbol="Contact" />
                </Button>
                <Button
                    x:Name="LogoutButton"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Click="OnLogoutClick"
                    ToolTipService.ToolTip="退出登录"
                    Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7E8;" />
                </Button>
            </Grid>

            <ListView
                x:Name="TrackList"
                Grid.Row="1"
                Padding="16,0,16,12"
                IsItemClickEnabled="True"
                ItemClick="OnTrackItemClick"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="72" />
                        <Setter Property="CornerRadius" Value="9" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Padding="12,14" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                Background="{ThemeResource ResonaSecondaryContainerBrush}"
                                CornerRadius="8">
                                <SymbolIcon
                                    Foreground="{ThemeResource ResonaOnSecondaryContainerBrush}"
                                    Symbol="MusicInfo" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Opacity="0.7"
                                    FontSize="12"
                                    Text="{x:Bind ArtistAlbum}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                FontSize="12"
                                Text="{x:Bind DurationText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="LoginOverlay"
                Grid.Row="1"
                Background="{ThemeResource ResonaSurfaceBrush}"
                Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        Width="420"
                        MaxWidth="420"
                        Padding="24,48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <TextBlock
                            FontFamily="Georgia"
                            FontSize="40"
                            FontWeight="Bold"
                            Text="Resona." />
                        <TextBlock
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="连接你的音乐空间" />
                        <TextBlock
                            Opacity="0.7"
                            Text="登录自托管服务器，聆听本地与网盘收藏。"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="ServerBox"
                            CornerRadius="12"
                            Header="服务器地址"
                            PlaceholderText="https://music.example.com" />
                        <TextBox
                            x:Name="UsernameBox"
                            CornerRadius="12"
                            Header="用户名"
                            Text="admin" />
                        <PasswordBox
                            x:Name="PasswordBox"
                            CornerRadius="12"
                            Header="密码"
                            PlaceholderText="密码" />
                        <Button
                            x:Name="SubmitLoginButton"
                            Margin="0,12,0,0"
                            Height="48"
                            HorizontalAlignment="Stretch"
                            CornerRadius="12"
                            Click="OnSubmitLoginClick"
                            Content="连接服务器"
                            Style="{ThemeResource AccentButtonStyle}" />
                        <TextBlock
                            x:Name="LoginStatus"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="0.7"
                            FontSize="12"
                            Text="凭据保存在设备安全存储中。首次使用请先在服务端网页设置管理员密码；公网连接建议使用 HTTPS。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Row="2"
                Background="{ThemeResource ResonaSecondaryContainerBrush}"
                BorderBrush="{ThemeResource ResonaOutlineVariantBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar
                        x:Name="SeekBar"
                        Grid.Row="0"
                        Height="2"
                        Minimum="0"
                        Maximum="1"
                        Background="{ThemeResource ResonaSurfaceContainerHighestBrush}"
                        Foreground="{ThemeResource ResonaAccentBrush}"
                        Tapped="OnSeekBarTapped" />
                    <Grid
                        Grid.Row="1"
                        Padding="12,8"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Background="{ThemeResource ResonaSurfaceContainerHighestBrush}"
                            CornerRadius="8">
                            <SymbolIcon
                                Foreground="{ThemeResource ResonaOnSecondaryContainerBrush}"
                                Symbol="MusicInfo" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="NowPlaying"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="Resona · 此刻想听什么？"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="TimeLabel"
                                Opacity="0.7"
                                FontSize="12"
                                Text="0:00 / 0:00" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                x:Name="PreviousButton"
                                Width="36"
                                Height="36"
                                Click="OnPreviousClick"
                                ToolTipService.ToolTip="上一首">
                                <SymbolIcon Symbol="Previous" />
                            </Button>
                            <Button
                                x:Name="PlayButton"
                                Width="36"
                                Height="36"
                                Click="OnPlayPauseClick"
                                ToolTipService.ToolTip="播放 / 暂停">
                                <SymbolIcon Symbol="Play" />
                            </Button>
                            <Button
                                x:Name="NextButton"
                                Width="36"
                                Height="36"
                                Click="OnNextClick"
                                ToolTipService.ToolTip="下一首">
                                <SymbolIcon Symbol="Next" />
                            </Button>
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            Click="OnToggleLyricsClick"
                            ToolTipService.ToolTip="桌面歌词">
                            <SymbolIcon Symbol="Comment" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
