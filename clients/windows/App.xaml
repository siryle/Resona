<Application
    x:Class="Resona.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ResonaAccentBrush" Color="#FFB397" />
                    <SolidColorBrush x:Key="ResonaSurfaceBrush" Color="#201F1C" />
                    <SolidColorBrush x:Key="ResonaSurfaceContainerLowBrush" Color="#262722" />
                    <SolidColorBrush x:Key="ResonaSurfaceContainerHighestBrush" Color="#393D33" />
                    <SolidColorBrush x:Key="ResonaOutlineVariantBrush" Color="#55594F" />
                    <SolidColorBrush x:Key="ResonaSecondaryContainerBrush" Color="#3C4434" />
                    <SolidColorBrush x:Key="ResonaOnSecondaryContainerBrush" Color="#DCE7CD" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFB397" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#3C4434" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3C4434" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#393D33" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#393D33" />
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
                    <CornerRadius x:Key="ListViewItemCornerRadius">9</CornerRadius>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ResonaAccentBrush" Color="#A83F22" />
                    <SolidColorBrush x:Key="ResonaSurfaceBrush" Color="#F6F4EE" />
                    <SolidColorBrush x:Key="ResonaSurfaceContainerLowBrush" Color="#FBFAF7" />
                    <SolidColorBrush x:Key="ResonaSurfaceContainerHighestBrush" Color="#EAECE2" />
                    <SolidColorBrush x:Key="ResonaOutlineVariantBrush" Color="#DFDFD6" />
                    <SolidColorBrush x:Key="ResonaSecondaryContainerBrush" Color="#E5EADB" />
                    <SolidColorBrush x:Key="ResonaOnSecondaryContainerBrush" Color="#34432E" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#A83F22" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#E5EADB" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#E5EADB" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#EAECE2" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#EAECE2" />
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
                    <CornerRadius x:Key="ListViewItemCornerRadius">9</CornerRadius>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
